# =========================================================
# BookChain - 블록체인 ebook 플랫폼 환경변수
# 이 파일을 .env로 복사하고 값을 입력하세요
# =========================================================

# --- 백엔드 ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- 블록체인 ---
# 배포자 개인키 (0x 포함) - 절대 공개하지 마세요!
PRIVATE_KEY=0xyour_private_key_here

# RPC URL (Alchemy, Infura 등)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your_api_key

# 블록 탐색기 API 키 (컨트랙트 검증용)
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# --- IPFS (Pinata) ---
# https://app.pinata.cloud 에서 API 키 발급
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud

# --- 프론트엔드 (Vite 환경변수는 VITE_ 접두어 필수) ---
VITE_NFT_ADDRESS=0x_deployed_nft_contract_address
VITE_MARKETPLACE_ADDRESS=0x_deployed_marketplace_contract_address
VITE_API_URL=http://localhost:3001
