# BookChain 개발 환경 기본값
# 실제 배포 시 이 파일을 수정하거나 .env.production 별도 생성

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 블록체인 (로컬 Hardhat 기본값)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SEPOLIA_RPC_URL=
MUMBAI_RPC_URL=
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# IPFS (Pinata) - 없으면 데모 모드로 동작
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud

# 스마트 컨트랙트 주소 (배포 후 업데이트)
VITE_NFT_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
VITE_API_URL=http://localhost:3001
